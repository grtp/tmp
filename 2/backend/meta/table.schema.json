{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "table-maint/meta/table.schema.json",
  "title": "table-maint table metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "table", "displayName", "primaryKey", "permissions", "columns"],
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "SQL Server schema (e.g. dbo)"
    },
    "table": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "primaryKey": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Column names. Composite keys are supported."
    },
    "rowVersionColumn": {
      "type": "string",
      "description": "Name of the rowversion column. Enables optimistic locking."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read":  { "$ref": "#/$defs/roleList" },
        "write": { "$ref": "#/$defs/roleList" }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "denyInsert": { "type": "boolean", "default": false },
        "denyDelete": { "type": "boolean", "default": false },
        "protect": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "column", "value"],
            "properties": {
              "kind":   { "const": "lastRowMatching" },
              "column": { "type": "string" },
              "value":  { "type": "string" }
            }
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" }
    }
  },
  "$defs": {
    "roleList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["admin", "maintainer", "user"] },
      "description": "Empty array = nobody (used to hide a table without deleting the file)."
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "displayName": { "type": "string" },
        "type": {
          "enum": ["string", "int", "decimal", "bool", "date", "datetime", "uuid"],
          "description": "Normalized type. The loader maps it against INFORMATION_SCHEMA at startup."
        },
        "nullable":   { "type": "boolean", "default": false },
        "readonly":   { "type": "boolean", "default": false },
        "required":   { "type": "boolean", "default": false },
        "searchable": { "type": "boolean", "default": false },
        "maxLength":  { "type": "integer", "minimum": 1 },
        "min":        { "type": "number" },
        "max":        { "type": "number" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "number"] },
          "description": "Restricts input to these values; frontend renders a select."
        }
      }
    }
  }
}
