# deploy/.env.dev — 開発用の設定(make be_serve / be_serve_mock が読む)
#
# 本番の deploy/.env と「キーの並び・意味」を完全に揃えてある(値だけ違う)。
# 形が同じなので，本番で何を差し替えるかがこのファイルとの差分で分かる。
# ひな形と各キーの説明は deploy/.env.example を参照。
#
# ここに書いてよいのは開発専用の値だけ(本番の秘密は deploy/.env へ。
# あちらは git 管理外)。

# --- HTTP ---
ADDR=:8080
CORS_ORIGIN=http://localhost:4200

# --- 前段プロキシの信頼 ---
# 開発は backend へブラウザ(ng serve のプロキシ)から直接つながるため,
# 信頼するプロキシは無し = 接続元をそのまま client_ip にする。
TRUSTED_PROXIES=

# --- ログ ---
# LOG_FORMAT: text(既定。podman logs を人が読む前提) | json(集約基盤へ流す場合)
# LOG_LEVEL : debug | info(既定) | warn | error
LOG_FORMAT=text
LOG_LEVEL=info

# --- SQL Server(compose.dev.yaml の ft-mssql) ---
MSSQL_DSN=sqlserver://sa:Fidev01!@localhost:1433?database=ftool
APP_DB_SCHEMA=dbo

# --- LDAP 認証(compose.dev.yaml の ft-ldap = OpenLDAP) ---
# 本番 AD との違いは属性名と GUID 形式だけ。キーは本番と同一。
LDAP_URL=ldap://localhost:1389
LDAP_BASE_DN=dc=example,dc=local
LDAP_USER_FILTER=(uid=%s)
LDAP_BIND_DN=cn=admin,dc=example,dc=local
LDAP_BIND_PASSWORD=Fidev01!
LDAP_STARTTLS=false
LDAP_ATTR_GUID=entryUUID
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_MAIL=mail
LDAP_GUID_FORMAT=uuid-string

# --- モック認証 ---
# 既定は本番と同じく false。make be_serve_mock が環境変数で true を上書きする。
LDAP_MOCK=false
LDAP_MOCK_USER=admin
LDAP_MOCK_PASS=admin

# --- セッション(compose.dev.yaml の ft-redis = Valkey) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL_MIN=30
COOKIE_NAME=sid
COOKIE_SECURE=false

# --- 認可 ---
AUTO_GRANT_TABLE_MAINT_VIEW=true

# --- 接続先パスワードの暗号鍵(開発専用。本番は openssl rand -base64 32) ---
CONN_ENC_KEY=ZGV2LWtleS0zMmJ5dGVzLWZvci1mLXRvb2wtZGV2ISE=

# --- 監査履歴 detail の退避先(dev は compose.dev.yaml の ft-minio) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=devminio
MINIO_SECRET_KEY=Fidev01!
MINIO_BUCKET=audit-overflow
MINIO_USE_SSL=false
