# deploy/.env.example — backend の設定ファイルのひな形(dev / 本番 共通の形)
#
# このファイルをコピーして使う:
#   本番: deploy/.env      (compose が env_file として読み backend へ渡す)
#   開発: deploy/.env.dev  (make be_serve が ENV_FILE で指定し backend が読む)
#
# キーの並び・意味は dev と本番で完全に同じ。値だけが違う。
# 各行の「本番例」「dev例」を見比べれば,本番で何を差し替えるか分かる。
# 書き方は KEY=VALUE の1行1件。# で始まる行はコメント。値の途中に # を
# 書くとコメントにならないので注意。値は引用符で囲まなくてよい
# (囲んだ場合は外される)。読み手が本番=compose・開発=backend 自身
# (backend/internal/config/envfile.go)と別なので,この2つの流儀から
# はみ出す書き方(行継続・変数展開など)はしないこと。
# 環境変数が設定済みならそちらが優先される(compose の environment や
# `LDAP_MOCK=true make be_serve` のような一時的な上書き)。
#
# 秘密(パスワード・暗号鍵)を含むため deploy/.env は git 管理外
# (deploy/.env.dev は開発専用の値しか持たないため管理下に置いている)。

# --- HTTP ---
# 本番: compose の environment が :8080 を渡すため .env の値は使われない
ADDR=:8080
# ng serve からの開発用 CORS。本番は nginx 同一オリジンなので未使用
CORS_ORIGIN=http://localhost:4200

# --- 前段プロキシの信頼(監査履歴の client_ip に効く) ---
# X-Forwarded-For を信じてよい相手を CIDR / IP で列挙する(カンマ区切り)。
# ここに載っていない相手から来たヘッダは無視し,接続元をそのまま記録する。
#   空(既定)  : どのプロキシも信じない。前段が無い開発環境向け
#   本番       : compose で固定したコンテナ用サブネット 10.89.0.0/24
# 注意: 広げすぎない。社内 LAN のアドレスを含めてしまうと,実クライアントを
# プロキシと誤認して読み飛ばし,IP 詐称を防げなくなる(10.0.0.0/8 等は不可)。
TRUSTED_PROXIES=10.89.0.0/24

# --- ログ ---
# LOG_FORMAT: text(既定。podman logs を人が読む前提) | json(集約基盤へ流す場合)
# LOG_LEVEL : debug | info(既定) | warn | error
LOG_FORMAT=text
LOG_LEVEL=info

# --- SQL Server(本ツール自身のDB) ---
# 本番例: sqlserver://svc_ftool:***@db.example.local:1433?database=ftool
# dev 例: sqlserver://sa:Fidev01!@localhost:1433?database=ftool
MSSQL_DSN=sqlserver://sa:CHANGE_ME@localhost:1433?database=ftool
# ftool_app_* テーブルを置くスキーマ(DB 側から専用スキーマを指定された場合に変更)
APP_DB_SCHEMA=dbo

# --- LDAP 認証 ---
# 本番は AD,dev は OpenLDAP。属性名が違うだけで設定キーは同じ。
#   本番(AD)      : LDAP_URL=ldaps://dc.example.local:636
#                    LDAP_BASE_DN=DC=example,DC=local
#                    LDAP_USER_FILTER=(sAMAccountName=%s)
#                    LDAP_ATTR_GUID=objectGUID / LDAP_ATTR_USERNAME=sAMAccountName
#                    LDAP_GUID_FORMAT=ad-binary
#   dev(OpenLDAP): LDAP_URL=ldap://localhost:1389
#                    LDAP_BASE_DN=dc=example,dc=local
#                    LDAP_USER_FILTER=(uid=%s)
#                    LDAP_ATTR_GUID=entryUUID / LDAP_ATTR_USERNAME=uid
#                    LDAP_GUID_FORMAT=uuid-string
LDAP_URL=ldaps://dc.example.local:636
LDAP_BASE_DN=DC=example,DC=local
LDAP_USER_FILTER=(sAMAccountName=%s)
LDAP_BIND_DN=CN=svc-ldap,OU=Service,DC=example,DC=local
LDAP_BIND_PASSWORD=CHANGE_ME
LDAP_STARTTLS=false
LDAP_ATTR_GUID=objectGUID
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_MAIL=mail
# ad-binary(AD の objectGUID) | uuid-string(OpenLDAP の entryUUID)
LDAP_GUID_FORMAT=ad-binary

# --- モック認証(開発専用。本番では必ず false) ---
# true にすると LDAP を使わず LDAP_MOCK_USER/PASS でログインできる。
# make be_serve_mock は環境変数で true を上書きするため,このファイルは
# dev でも false のままでよい。
LDAP_MOCK=false
LDAP_MOCK_USER=admin
LDAP_MOCK_PASS=admin

# --- セッション(Valkey / Redis 互換) ---
# 本番: compose の environment が redis:6379 を渡す / dev: localhost:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL_MIN=30
COOKIE_NAME=sid
# HTTPS 終端がある本番では true
COOKIE_SECURE=false

# --- 認可 ---
# 初回ログイン時に table-maint:user を自動付与する(false だと admin が
# 権限を付けるまでダッシュボードに何も出ない)
AUTO_GRANT_TABLE_MAINT_VIEW=true

# --- 接続先パスワードの暗号鍵(必須。base64 32byte) ---
# 本番は必ず `openssl rand -base64 32` で生成した値にする。
# 変更すると登録済み接続のパスワードが復号できなくなる。
CONN_ENC_KEY=CHANGE_ME

# --- 監査履歴 detail の 1MB 超過分の退避先(既定で有効) ---
# 超過分は claim check パターンで MinIO へ退避し, 履歴の
# [JSONをダウンロード]から backend 経由で全文を取得できる(手順書 §8.5)。
# MINIO_ENDPOINT を空にすると退避機能そのものを無効化できる
# (その場合 1MB 超の detail は記録時点で破棄される。履歴の行自体は残る)。
# 値は compose のサービス名。ブラウザからは触らせない(内部ネットワーク限定)。
MINIO_ENDPOINT=minio:9000
# ACCESS_KEY / SECRET_KEY はこの値で MinIO 自身が初期化される
# (外部から発行されるものではなく, 自分で決める)。空のままだと MinIO は
# 起動失敗せず既知の既定値 minioadmin:minioadmin で立ち上がってしまうため,
# 必ず設定すること。生成例は README の「本番デプロイ 0) 事前準備」。
# 制約: ACCESS_KEY は3文字以上, SECRET_KEY は8文字以上。
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=audit-overflow
MINIO_USE_SSL=false

# --- compose 用(backend は読まない) ---
# イメージのタグ。ビルド環境で付けた値と本番で load した値を一致させる。
# 日付運用(本番に何が入っているかを追えるようにするため。:latest は不可)。
#   ビルド: IMAGE_TAG=2026-07-30 podman compose -f deploy/compose.yaml build
#   配布  : podman save -o ftool-2026-07-30.tar \
#             localhost/ftool-backend:2026-07-30 \
#             localhost/ftool-frontend:2026-07-30 \
#             docker.io/valkey/valkey:8-alpine
#   本番  : podman load -i ftool-2026-07-30.tar && podman compose up -d
# 詳細は運用・保守手順書 §3.1。
IMAGE_TAG=2026-07-30

# 受け口の構成は次の2択。3つの値をセットで切り替える(手順書 §1.3)。
#
#   環境A: このコンテナ nginx が唯一の受け口(ホストに nginx が居ない)
#     FRONTEND_BIND=0.0.0.0
#     FRONTEND_PORT=80              -> 利用者は http://<IP>/
#     NGINX_CONF=standalone.conf
#
#   環境B: 前段にホスト nginx が居る(既定。下記の値がそれ)
#     FRONTEND_BIND=127.0.0.1       -> LAN へ直接出さない
#     FRONTEND_PORT=8081            -> ホスト nginx の転送先
#     NGINX_CONF=default.conf
#     ホスト nginx 側: deploy/nginx/host-frontend.conf.example を
#     /etc/nginx/conf.d/ftool.conf へ置く(既定は listen 8082 なので
#     利用者は http://<IP>:8082/)
#
# FRONTEND_BIND を 127.0.0.1 のままにするのは, 前段を経由せず直接叩かれると
# クライアントが自前の X-Forwarded-For を送って操作履歴の client_ip を
# 詐称できるため。環境A では nginx 側(standalone.conf)で $remote_addr に
# 上書きして塞いでいる。
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8081
# マウントする nginx 設定。環境A/B で X-Forwarded-For の扱いが変わるため,
# ファイルを手編集せず conf ごと差し替える(差分は 1 行だけ)。
# rootless podman では 1024 未満のポートを直接使えないことがある。
NGINX_CONF=default.conf
