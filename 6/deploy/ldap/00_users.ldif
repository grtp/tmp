# deploy/ldap/00_users.ldif
# 開発用 OpenLDAP の初期データ。bitnami/openldap が LDAP_CUSTOM_LDIF_DIR
# 経由で投入する(カスタム LDIF を使う場合はルートエントリも自前で書く)。
#
# ペルソナ(パスワードは全員 Passw0rd!):
#   tanaka : admin 想定      (ログイン後 02_grant_admin.sql.example で付与)
#   suzuki : maintainer 想定 (設定画面から付与)
#   sato   : user 想定       (AUTO_GRANT_TABLE_MAINT_VIEW=true なら閲覧のみ可)
#
# 注意: entryUUID はサーバー生成のため事前に決められない。権限はログイン後に
# 付与する運用になる。表示名は LDIF の base64 エンコードを避けるため ASCII。

dn: dc=example,dc=local
objectClass: dcObject
objectClass: organization
dc: example
o: Example Local

dn: ou=users,dc=example,dc=local
objectClass: organizationalUnit
ou: users

dn: uid=tanaka,ou=users,dc=example,dc=local
objectClass: inetOrgPerson
uid: tanaka
cn: Taro Tanaka
sn: Tanaka
displayName: Taro Tanaka
mail: tanaka@example.local
userPassword: Passw0rd!

dn: uid=suzuki,ou=users,dc=example,dc=local
objectClass: inetOrgPerson
uid: suzuki
cn: Jiro Suzuki
sn: Suzuki
displayName: Jiro Suzuki
mail: suzuki@example.local
userPassword: Passw0rd!

dn: uid=sato,ou=users,dc=example,dc=local
objectClass: inetOrgPerson
uid: sato
cn: Hanako Sato
sn: Sato
displayName: Hanako Sato
mail: sato@example.local
userPassword: Passw0rd!
