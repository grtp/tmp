# deploy/nginx/host-frontend.conf.example
# 環境B: 既に nginx が動いているサーバーへ F-tool を追加する場合のひな形。
# ホスト側 nginx の conf.d(例 /etc/nginx/conf.d/ftool.conf)へ置く。
#
#   cp deploy/nginx/host-frontend.conf.example /etc/nginx/conf.d/ftool.conf
#   vi /etc/nginx/conf.d/ftool.conf      # listen / server_name / 転送先ポートを直す
#   nginx -t && systemctl reload nginx
#
# 置く前に include 構造を確認すること(ディストリによっては conf.d ではなく
# sites-enabled を使う):
#   nginx -T | grep -E "include|server_name|listen" | head -30
#
# 役割分担(2段のリバースプロキシ):
#   ホスト nginx  … 受け口。ここでは転送するだけ
#   コンテナ nginx … SPA の配信・フォールバック・キャッシュ・/api の中継
# SPA の配信規則をコンテナ側に閉じ込めることで, 環境ごとに書き写すのは
# この1ファイルだけで済む(F-tool 側を入れ替えてもホスト nginx は無変更)。
#
# 【サブパスにしないこと】
# SPA は <base href="/">, セッション Cookie も Path=/ のため,
# https://portal.example.local/ftool/ のような間借りにすると base href を
# 変えた再ビルドが必要になり, Cookie も同居アプリと衝突する。
# 専用のホスト名かポートを割り当てること。

server {
    # 【ポートで分ける(DNS を使わず IP でアクセスする構成)】
    # 既存アプリと同じ IP の :80 を共有すると, ホスト名が無いため nginx は
    # 振り分けられない(既存 server が default_server なら IP アクセスは
    # そちらへ吸われて F-tool に届かない)。専用ポートで受ける。
    #   -> 利用者のアクセス先は http://<このサーバーのIP>:8082/
    listen 8082;
    # _ = 任意のホスト名にマッチ。IP 直アクセスでもそのまま通る。
    # 将来 DNS 名を割り当てたらここを FQDN に書き換えるだけでよい
    # (SPA の base href とセッション Cookie はホスト名に依存しない)。
    server_name _;
    #
    # 【FQDN で分ける場合】上の listen/server_name を次に差し替え,
    # DNS もこのサーバーへ向ける。専用ホスト名なら :80 のままでよい。
    #   listen 80;
    #   server_name ftool.example.local;

    # HTTPS で終端する場合はこの server を ssl にし,
    # backend の .env で COOKIE_SECURE=true にすること
    # (忘れると Cookie に Secure 属性が付かない)。
    # IP アクセスのままでは証明書の発行が難しいため, HTTPS 化するなら
    # FQDN を用意する方が現実的(運用・保守手順書 §8.3)。
    # listen 8443 ssl;
    # ssl_certificate     /etc/pki/tls/certs/ftool.crt;
    # ssl_certificate_key /etc/pki/tls/private/ftool.key;

    # CSV 一括取込は行データを JSON で送るため既定の 1MB では足りない。
    # 【重要】外側(このファイル)の上限が先に効くので, コンテナ側だけ
    # 広げても 413 になる。両方に同じ値を書くこと。
    client_max_body_size 32m;

    location / {
        # compose の frontend コンテナ(.env の FRONTEND_BIND:FRONTEND_PORT)。
        # 環境B では既定のまま 127.0.0.1:8081 に閉じておく — LAN から直接
        # 叩けると, クライアントが自前の X-Forwarded-For を送って操作履歴の
        # client_ip を詐称できるため(backend は前段を信頼する前提で動く)。
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 操作履歴の client_ip はこのヘッダから解決される。
        # ここは外部と接する信頼境界なので, クライアントが自称した
        # X-Forwarded-For は引き継がず $remote_addr で上書きする
        # ($proxy_add_x_forwarded_for だと詐称値がそのまま残り,
        #  監査ログの IP を偽装できてしまう)。
        # このサーバー自身がさらに別の LB の背後にある場合だけ,
        # $proxy_add_x_forwarded_for に変えて前段を信頼する。
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CSV 出力のストリーミング用(コンテナ側と同じ値)。
        proxy_read_timeout 300s;
        proxy_buffering    off;
    }
}
