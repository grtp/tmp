{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "projects": {
    "mock": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "mock",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/mock",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["libs/ui/src/styles/material-theme.scss", "src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "port": 4300 },
          "configurations": {
            "production": { "buildTarget": "mock:build:production" },
            "development": { "buildTarget": "mock:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
